<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="none">
  <defs>
    <radialGradient id="mx-bg" cx="50%" cy="38%" r="75%">
      <stop offset="0%" stop-color="#161616"/>
      <stop offset="60%" stop-color="#0B0B0B"/>
      <stop offset="100%" stop-color="#000000"/>
    </radialGradient>
    <linearGradient id="mx-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FF3B30"/>
      <stop offset="0.5" stop-color="#FF8A80"/>
      <stop offset="1" stop-color="#C40000"/>
    </linearGradient>
    <linearGradient id="mx-handle" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FF6B5E"/>
      <stop offset="0.5" stop-color="#E30613"/>
      <stop offset="1" stop-color="#8F0000"/>
    </linearGradient>
    <linearGradient id="mx-bag" x1="0" y1="0" x2="0.25" y2="1">
      <stop offset="0" stop-color="#FF4A3D"/>
      <stop offset="0.35" stop-color="#E30613"/>
      <stop offset="0.8" stop-color="#C40000"/>
      <stop offset="1" stop-color="#8F0000"/>
    </linearGradient>
    <linearGradient id="mx-bagside" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B90000"/>
      <stop offset="1" stop-color="#7A0000"/>
    </linearGradient>
    <linearGradient id="mx-letter" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF"/>
      <stop offset="0.55" stop-color="#F2F2F2"/>
      <stop offset="1" stop-color="#C9C9C9"/>
    </linearGradient>
    <linearGradient id="mx-x" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FF6B5E"/>
      <stop offset="0.45" stop-color="#E30613"/>
      <stop offset="1" stop-color="#8F0000"/>
    </linearGradient>
    <radialGradient id="mx-rivet" cx="35%" cy="35%" r="65%">
      <stop offset="0" stop-color="#FFFFFF"/>
      <stop offset="0.7" stop-color="#E8E8E8"/>
      <stop offset="1" stop-color="#9A9A9A"/>
    </radialGradient>
    <filter id="mx-glow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="14" result="b"/>
      <feMerge>
        <feMergeNode in="b"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="512" height="512" rx="96" fill="url(#mx-bg)"/>
  <circle cx="256" cy="230" r="188" stroke="url(#mx-ring)" stroke-width="11" filter="url(#mx-glow)" opacity="0.95"/>
  <circle cx="256" cy="230" r="214" stroke="#FF2D2D" stroke-width="3" opacity="0.25"/>
  <path d="M192 172C192 84 320 84 320 172" stroke="url(#mx-handle)" stroke-width="30" stroke-linecap="round" fill="none"/>
  <path d="M192 172C192 84 320 84 320 172" stroke="#FFD9D4" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.35"/>
  <path d="M128 172H384V392L256 296L128 392V172Z" fill="url(#mx-bag)" stroke="#FF8A7E" stroke-width="5" stroke-linejoin="round"/>
  <path d="M128 172H188V368L128 380V172Z" fill="url(#mx-bagside)" opacity="0.85"/>
  <path d="M324 172H384V380L324 368V172Z" fill="url(#mx-bagside)" opacity="0.65"/>
  <path d="M140 178H300V206C220 214 168 202 140 190V178Z" fill="#FFFFFF" opacity="0.16"/>
  <path d="M140 210H190V360L140 344V210Z" fill="#FFFFFF" opacity="0.1"/>
  <circle cx="192" cy="172" r="17" fill="url(#mx-rivet)" stroke="#7A7A7A" stroke-width="1.5"/>
  <circle cx="320" cy="172" r="17" fill="url(#mx-rivet)" stroke="#7A7A7A" stroke-width="1.5"/>
  <circle cx="186" cy="166" r="5" fill="#FFFFFF" opacity="0.9"/>
  <circle cx="314" cy="166" r="5" fill="#FFFFFF" opacity="0.9"/>
  <text x="256" y="268" text-anchor="middle" fill="url(#mx-letter)" font-family="'Arial Black', Arial, sans-serif" font-weight="900" font-size="104" letter-spacing="2">M</text>
  <text x="256" y="462" text-anchor="middle" font-family="'Arial Black', Arial, sans-serif" font-weight="900" font-size="78" letter-spacing="10"><tspan fill="url(#mx-letter)">M</tspan><tspan fill="url(#mx-letter)">O</tspan><tspan fill="url(#mx-x)">X</tspan></text>
</svg>
